---
import { Image } from 'astro:assets';
import heroImg from '../assets/mapa-especies.png';
import { hero } from '../data/textos';
---
<section id="inicio" class="relative overflow-hidden bg-noche text-noche-texto">
  <!-- Map render as texture, fading into the background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={heroImg}
      alt=""
      widths={[800, 1200]}
      sizes="(min-width: 1024px) 60vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute right-0 top-0 h-full w-full object-cover opacity-55 lg:w-[62%] [image-rendering:pixelated]"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-noche via-noche/85 to-noche/10"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-noche to-transparent"></div>
  </div>

  <div class="contenedor relative pb-16 pt-32 sm:pt-40 lg:pb-24 lg:pt-48">
    <p class="etiqueta text-brillo">{hero.antetitulo}</p>
    <h1 class="mt-5 max-w-3xl text-[2.5rem] font-semibold leading-[1.04] sm:text-6xl lg:text-7xl">
      {hero.titulo}
    </h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-noche-suave sm:text-lg">{hero.bajada}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={hero.cta1.href} class="rounded-full bg-brillo px-5 py-2.5 text-sm font-medium text-noche transition hover:bg-white">
        {hero.cta1.texto}
      </a>
      <a href={hero.cta2.href} class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium transition hover:border-white/60">
        {hero.cta2.texto}
      </a>
    </div>

    <dl class="mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-noche-linea bg-noche-linea sm:mt-28 lg:grid-cols-4">
      {hero.datos.map((d) => (
        <div class="bg-noche/90 px-5 py-5 backdrop-blur">
          <dt class="sr-only">{d.texto}</dt>
          <dd>
            <span class="cifra block text-3xl font-medium sm:text-4xl">{d.valor}</span>
            <span class="mt-2 block text-sm text-noche-suave" aria-hidden="true">{d.texto}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="etiqueta mt-5 max-w-xl normal-case tracking-normal text-noche-suave/80">{hero.pie}</p>
  </div>
</section>
