---
// Split-screen comparison: catastro (left, bottom map) vs prediction (right, top map).
// The top map takes all interaction; the bottom map follows its camera.
// The top map's canvas is clipped at the divider so the catastro shows through on the left.
import { Image } from 'astro:assets';
import Cabecera from './Cabecera.astro';
import heroImg from '../assets/mapa-especies.png';
import { mapa as t } from '../data/textos';
import { ESPECIES, HUERTO } from '../data/especies';
import meta from '../data/mapa.json';
import { ruta } from '../data/ruta';

const config = {
  bounds: meta.bounds,
  minzoom: meta.minzoom,
  maxzoom: meta.maxzoom,
  tiles: ruta('tiles/{fuente}-{capa}/{z}/{x}/{y}.png'),
};
---
<section aria-labelledby="mapa" class="bg-noche py-24 text-noche-texto sm:py-32">
  <div class="contenedor">
    <Cabecera id="mapa" antetitulo={t.antetitulo} titulo={t.titulo} bajada={t.bajada} oscuro />

    <div class="mt-14 grid gap-6 lg:grid-cols-12" data-revelar>
      <div class="lg:col-span-9">
        <div id="comparador" data-config={JSON.stringify(config)}
          class="relative aspect-[4/5] w-full touch-pan-y overflow-hidden rounded-xl border border-noche-linea sm:aspect-[16/11]"
          role="region" aria-label="Comparación entre el catastro frutícola y la predicción de HuertoMap en Curicó y Molina">
          <Image src={heroImg} alt="Vista estática del mapa de especies predicho en Curicó y Molina"
            widths={[600, 1200]} sizes="(min-width: 1024px) 70vw, 100vw"
            class="respaldo absolute inset-0 h-full w-full object-cover opacity-70 [image-rendering:pixelated]" />
          <p class="respaldo etiqueta absolute bottom-4 left-4 rounded bg-noche/80 px-2 py-1 text-noche-suave">{t.cargando}</p>

          <!-- Inline position: maplibre-gl.css sets .maplibregl-map { position: relative } and loads later.
               The prediction map sits in a right-anchored overflow:hidden window whose left edge follows the
               divider. (clip-path on the map would be simpler, but Chrome then stops drawing its WebGL canvas.) -->
          <div id="mapa-catastro" style="position:absolute;inset:0"></div>
          <div id="ventana-prediccion" style="position:absolute;top:0;bottom:0;right:0;left:50%;overflow:hidden">
            <div id="mapa-prediccion" style="position:absolute;top:0;bottom:0;right:0;width:var(--ancho-mapa,100%)"></div>
          </div>
          <!-- Controls shared by both maps, outside the clipped window -->
          <div id="controles-mapa" class="maplibregl-map" style="position:absolute;inset:0;pointer-events:none;z-index:5;background:none">
            <div class="maplibregl-ctrl-top-right" data-esquina="top-right"></div>
            <div class="maplibregl-ctrl-bottom-left" data-esquina="bottom-left"></div>
            <div class="maplibregl-ctrl-bottom-right" data-esquina="bottom-right"></div>
          </div>

          <!-- Side labels -->
          <span class="etiqueta pointer-events-none absolute left-3 top-3 z-10 rounded bg-noche/80 px-2 py-1 text-noche-texto backdrop-blur">
            {t.rotulos.catastro.corto}<span class="hidden sm:inline"> {t.rotulos.catastro.resto}</span>
          </span>
          <span class="etiqueta pointer-events-none absolute right-14 top-3 z-10 rounded bg-brillo px-2 py-1 text-noche">
            {t.rotulos.prediccion.corto}<span class="hidden sm:inline"> {t.rotulos.prediccion.resto}</span>
          </span>

          <!-- Divider -->
          <div id="divisor" class="pointer-events-none absolute inset-y-0 z-10 w-0" style="left:50%">
            <span class="absolute inset-y-0 -left-px w-0.5 bg-white/90 shadow-[0_0_0_1px_rgba(0,0,0,.25)]"></span>
            <button id="manija" type="button" role="slider" aria-label={t.divisor}
              aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50 %"
              class="pointer-events-auto absolute top-1/2 left-0 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize touch-none items-center justify-center rounded-full border border-black/10 bg-white text-noche shadow-lg">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M6.5 4.5 2 9l4.5 4.5M11.5 4.5 16 9l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-noche-suave">{t.nota}</p>
      </div>

      <aside class="flex flex-col gap-8 lg:col-span-3" aria-label="Controles del mapa">
        <fieldset>
          <legend class="etiqueta text-noche-suave">Capa</legend>
          <div class="mt-3 inline-flex rounded-full border border-noche-linea p-1">
            {(['especies', 'huerto'] as const).map((k, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="capa" value={k} checked={i === 0} class="peer sr-only" />
                <span class="block rounded-full px-4 py-1.5 text-sm text-noche-suave transition peer-checked:bg-brillo peer-checked:text-noche peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-brillo">
                  {t.capas[k]}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="opacidad" class="etiqueta text-noche-suave">{t.opacidad}</label>
          <input id="opacidad" type="range" min="0" max="100" value="85" class="mt-3 w-full accent-[#5ee39a]" />
        </div>

        <div>
          <p class="etiqueta text-noche-suave">Leyenda</p>
          <ul id="leyenda-especies" class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-sm lg:grid-cols-1">
            {ESPECIES.map((e) => (
              <li class="flex items-center gap-2.5">
                <span class="h-3 w-3 shrink-0 rounded-[2px]" style={`background:${e.color}`} aria-hidden="true"></span>{e.nombre}
              </li>
            ))}
          </ul>
          <ul id="leyenda-huerto" class="mt-3 hidden text-sm">
            <li class="flex items-center gap-2.5">
              <span class="h-3 w-3 rounded-[2px]" style={`background:${HUERTO}`} aria-hidden="true"></span>Huerto frutal
            </li>
          </ul>
        </div>

        <p class="text-xs leading-relaxed text-noche-suave">{t.ayuda} {t.fondo}</p>
      </aside>
    </div>
  </div>
</section>

<script>
  import type { Map as MLMap, StyleSpecification } from 'maplibre-gl';

  type Config = { bounds: [number, number, number, number]; minzoom: number; maxzoom: number; tiles: string };
  type Capa = 'especies' | 'huerto';
  type Fuente = 'catastro' | 'prediccion';

  const caja = document.getElementById('comparador') as HTMLElement;
  const cfg = JSON.parse(caja.dataset.config!) as Config;
  const divisor = document.getElementById('divisor') as HTMLElement;
  const manija = document.getElementById('manija') as HTMLButtonElement;

  function estilo(fuente: Fuente): StyleSpecification {
    const capa = (c: Capa) => ({
      type: 'raster' as const,
      tiles: [cfg.tiles.replace('{fuente}', fuente).replace('{capa}', c)],
      tileSize: 256,
      bounds: cfg.bounds,
      minzoom: cfg.minzoom,
      maxzoom: cfg.maxzoom,
    });
    return {
      version: 8,
      sources: {
        fondo: {
          type: 'raster',
          tiles: ['https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg'],
          tileSize: 256,
          maxzoom: 15,
        },
        [`${fuente}-especies`]: capa('especies'),
        [`${fuente}-huerto`]: capa('huerto'),
      },
      layers: [
        { id: 'fondo', type: 'raster', source: 'fondo', paint: { 'raster-saturation': -0.35, 'raster-brightness-max': 0.8 } },
        { id: 'especies', type: 'raster', source: `${fuente}-especies`, paint: { 'raster-opacity': 0.85, 'raster-resampling': 'nearest' } },
        { id: 'huerto', type: 'raster', source: `${fuente}-huerto`, layout: { visibility: 'none' }, paint: { 'raster-opacity': 0.85, 'raster-resampling': 'nearest' } },
      ],
    };
  }

  async function iniciar() {
    const [{ default: maplibregl }] = await Promise.all([
      import('maplibre-gl'),
      import('maplibre-gl/dist/maplibre-gl.css'),
    ]);
    const [w, s, e, n] = cfg.bounds;
    const pad = 0.12;
    const comun = {
      bounds: cfg.bounds,
      fitBoundsOptions: { padding: 20 },
      maxBounds: [w - pad, s - pad, e + pad, n + pad] as [number, number, number, number],
      minZoom: 9,
      maxZoom: 16,
      cooperativeGestures: true,
      attributionControl: false as const,
      locale: {
        'CooperativeGesturesHandler.WindowsHelpText': 'Use Ctrl + rueda para acercar el mapa',
        'CooperativeGesturesHandler.MacHelpText': 'Use ⌘ + rueda para acercar el mapa',
        'CooperativeGesturesHandler.MobileHelpText': 'Use dos dedos para mover el mapa',
        'NavigationControl.ZoomIn': 'Acercar',
        'NavigationControl.ZoomOut': 'Alejar',
      },
    };

    // The prediction map keeps the full width of the comparator; its window crops it.
    const mapaPred = document.getElementById('mapa-prediccion') as HTMLElement;
    const ventana = document.getElementById('ventana-prediccion') as HTMLElement;
    const ajustarAncho = () => mapaPred.style.setProperty('--ancho-mapa', `${caja.clientWidth}px`);
    ajustarAncho();
    new ResizeObserver(ajustarAncho).observe(caja);

    const abajo = new maplibregl.Map({ container: 'mapa-catastro', ...comun, style: estilo('catastro') });
    const arriba = new maplibregl.Map({ container: mapaPred, ...comun, style: estilo('prediccion') });

    // Two-way camera sync, so dragging on either side moves both.
    let enSync = false;
    const enlazar = (desde: MLMap, hacia: MLMap) =>
      desde.on('move', () => {
        if (enSync) return;
        enSync = true;
        hacia.jumpTo({ center: desde.getCenter(), zoom: desde.getZoom(), bearing: desde.getBearing(), pitch: desde.getPitch() });
        enSync = false;
      });
    enlazar(arriba, abajo);
    enlazar(abajo, arriba);

    // Controls live in a shared overlay so the divider never hides them.
    const esquina = (k: string) => caja.querySelector<HTMLElement>(`[data-esquina="${k}"]`)!;
    const montar = (ctrl: { onAdd(m: MLMap): HTMLElement }, k: string) => {
      const el = ctrl.onAdd(arriba);
      el.style.pointerEvents = 'auto';
      esquina(k).appendChild(el);
    };
    montar(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    montar(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-left');
    const atrib = document.createElement('div');
    atrib.className = 'maplibregl-ctrl maplibregl-ctrl-attrib';
    atrib.style.cssText = 'pointer-events:auto;background:rgba(255,255,255,.85);color:#222;font-size:11px';
    atrib.innerHTML =
      '<div class="maplibregl-ctrl-attrib-inner"><a href="https://s2maps.eu" target="_blank" rel="noopener">' +
      '<span class="hidden sm:inline">Sentinel-2 cloudless </span>© EOX</a>' +
      '<span class="hidden sm:inline"> (Copernicus Sentinel 2020)</span> · <span class="sm:hidden">CIREN</span>' +
      '<span class="hidden sm:inline">Catastro Frutícola, CIREN</span></div>';
    esquina('bottom-right').appendChild(atrib);

    let pos = 50;
    const fijar = (p: number) => {
      pos = Math.min(100, Math.max(0, p));
      divisor.style.left = `${pos}%`;
      ventana.style.left = `${pos}%`;
      manija.setAttribute('aria-valuenow', String(Math.round(pos)));
      manija.setAttribute('aria-valuetext', `${Math.round(pos)} %`);
    };
    fijar(50);

    manija.addEventListener('pointerdown', (ev) => {
      manija.setPointerCapture(ev.pointerId);
      ev.preventDefault();
    });
    manija.addEventListener('pointermove', (ev) => {
      if (!manija.hasPointerCapture(ev.pointerId)) return;
      const r = caja.getBoundingClientRect();
      fijar(((ev.clientX - r.left) / r.width) * 100);
    });
    manija.addEventListener('keydown', (ev) => {
      const paso = ev.shiftKey ? 10 : 2;
      const teclas: Record<string, number> = {
        ArrowLeft: pos - paso, ArrowDown: pos - paso, ArrowRight: pos + paso, ArrowUp: pos + paso, Home: 0, End: 100,
      };
      if (ev.key in teclas) {
        ev.preventDefault();
        fijar(teclas[ev.key]);
      }
    });

    let cargados = 0;
    const listo = () => {
      if (++cargados === 2) caja.querySelectorAll('.respaldo').forEach((x) => x.remove());
    };
    abajo.once('load', listo);
    arriba.once('load', listo);

    const mapas: MLMap[] = [abajo, arriba];
    document.querySelectorAll<HTMLInputElement>('input[name="capa"]').forEach((r) =>
      r.addEventListener('change', () => {
        const capa = r.value as Capa;
        for (const m of mapas) {
          for (const id of ['especies', 'huerto'] as const) {
            m.setLayoutProperty(id, 'visibility', id === capa ? 'visible' : 'none');
          }
        }
        document.getElementById('leyenda-especies')!.classList.toggle('hidden', capa !== 'especies');
        document.getElementById('leyenda-huerto')!.classList.toggle('hidden', capa !== 'huerto');
      }),
    );
    const opacidad = document.getElementById('opacidad') as HTMLInputElement;
    opacidad.addEventListener('input', () => {
      const v = Number(opacidad.value) / 100;
      for (const m of mapas) for (const id of ['especies', 'huerto']) m.setPaintProperty(id, 'raster-opacity', v);
    });
  }

  const io = new IntersectionObserver(
    (entries) => {
      if (entries.some((x) => x.isIntersecting)) {
        io.disconnect();
        iniciar().catch((err) => console.error('[mapa]', err));
      }
    },
    { rootMargin: '300px' },
  );
  io.observe(caja);
</script>
