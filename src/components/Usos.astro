---
import Cabecera from './Cabecera.astro';
import { usos as t } from '../data/textos';
---
<section aria-labelledby="usos" class="py-24 sm:py-32">
  <div class="contenedor">
    <Cabecera id="usos" antetitulo={t.antetitulo} titulo={t.titulo} />
    <ul class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {t.items.map((u, i) => (
        <li class="border-t border-texto/80 pt-6" data-revelar style={`transition-delay:${i * 80}ms`}>
          <h3 class="text-lg font-semibold">{u.titulo}</h3>
          <p class="mt-3 leading-relaxed text-suave">{u.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
