---
import Cabecera from './Cabecera.astro';
import { metodo } from '../data/textos';
---
<section aria-labelledby="metodo" class="border-t border-linea py-24 sm:py-32">
  <div class="contenedor">
    <Cabecera id="metodo" antetitulo={metodo.antetitulo} titulo={metodo.titulo} />

    <ol class="relative mt-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- connecting line on wide screens -->
      <span class="absolute left-0 right-0 top-[11px] hidden h-px bg-linea lg:block" aria-hidden="true"></span>
      {metodo.pasos.map((p, i) => (
        <li class="relative" data-revelar style={`transition-delay:${i * 90}ms`}>
          <span class="relative z-10 flex h-[23px] w-[23px] items-center justify-center rounded-full border border-acento bg-fondo">
            <span class="h-2 w-2 rounded-full bg-acento"></span>
          </span>
          <p class="etiqueta mt-6 text-suave">Paso {i + 1}</p>
          <h3 class="mt-2 text-xl font-semibold">{p.titulo}</h3>
          <p class="mt-3 leading-relaxed text-suave">{p.texto}</p>
          <p class="mt-4 font-mono text-xs text-acento">{p.detalle}</p>
        </li>
      ))}
    </ol>

    <div class="mt-20 grid gap-6 rounded-xl bg-noche p-8 text-noche-texto sm:p-12 lg:grid-cols-12" data-revelar>
      <div class="lg:col-span-5">
        <p class="etiqueta text-brillo">Temporada no vista</p>
        <h3 class="mt-4 text-2xl font-semibold sm:text-3xl">{metodo.destacado.titulo}</h3>
      </div>
      <p class="text-lg leading-relaxed text-noche-suave lg:col-span-6 lg:col-start-7 lg:pt-8">{metodo.destacado.texto}</p>
    </div>
  </div>
</section>
