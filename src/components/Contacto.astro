---
import { contacto as t } from '../data/textos';
---
<section aria-labelledby="contacto" class="border-t border-linea py-24 sm:py-32">
  <div class="contenedor grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7" data-revelar>
      <p class="etiqueta text-acento">{t.antetitulo}</p>
      <h2 id="contacto" class="mt-5 text-3xl font-semibold leading-tight sm:text-5xl">{t.titulo}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-suave">{t.texto}</p>
      <a href={`mailto:${t.correo}`}
        class="mt-9 inline-flex items-center gap-3 rounded-full bg-texto px-6 py-3 font-medium text-fondo transition hover:bg-acento">
        {t.correo}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>
    <div class="lg:col-span-4 lg:col-start-9" data-revelar>
      <p class="etiqueta text-suave">Desarrollado por</p>
      <p class="mt-4 text-lg font-medium">{t.institucion}</p>
      <ul class="mt-6 space-y-3">
        {t.equipo.map((p) => (
          <li><span class="font-medium">{p.nombre}</span> <span class="text-suave">· {p.rol}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
