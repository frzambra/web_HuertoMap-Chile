---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Hero from '../components/Hero.astro';
import Productos from '../components/Productos.astro';
import Metodo from '../components/Metodo.astro';
import Exactitud from '../components/Exactitud.astro';
import Cobertura from '../components/Cobertura.astro';
import MapaInteractivo from '../components/MapaInteractivo.astro';
import Usos from '../components/Usos.astro';
import Contacto from '../components/Contacto.astro';
import Pie from '../components/Pie.astro';
---
<Base>
  <Encabezado />
  <main id="contenido">
    <Hero />
    <Productos />
    <Metodo />
    <Exactitud />
    <Cobertura />
    <MapaInteractivo />
    <Usos />
    <Contacto />
  </main>
  <Pie />
</Base>
